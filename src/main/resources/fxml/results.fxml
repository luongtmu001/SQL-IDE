<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="app.controllers.ResultsController"
      minHeight="150"
      prefHeight="260"
      styleClass="results-container"
      VBox.vgrow="ALWAYS">

    <!-- Results TabPane -->
    <TabPane fx:id="resultsTabPane" VBox.vgrow="ALWAYS" tabClosingPolicy="UNAVAILABLE" styleClass="results-tab-pane">

        <!-- 1. Results Grid Tab -->
        <Tab fx:id="resultsTab" text="Results (50)">
            <graphic><FontIcon iconLiteral="fth-grid"/></graphic>
            <VBox VBox.vgrow="ALWAYS">
                <!-- Mini Results Action Bar -->
                <HBox styleClass="results-mini-toolbar" alignment="CENTER_LEFT" spacing="8">
                    <!-- Instant Filter in results -->
                    <HBox styleClass="quick-search-box" alignment="CENTER_LEFT">
                        <FontIcon iconLiteral="fth-search"/>
                        <TextField fx:id="resultsFilterField" promptText="Filter in results..." styleClass="quick-search-input" prefWidth="180"/>
                    </HBox>

                    <!-- Stats Label -->
                    <Label fx:id="resultsStatsLabel" text="50 rows retrieved (42 ms)" styleClass="results-stats-label"/>

                    <Pane HBox.hgrow="ALWAYS"/>

                    <!-- Compare results: deferred (Gate B 2026-11-05: shown disabled) -->
                    <Button text="So sánh (chưa hỗ trợ)" disable="true" styleClass="flat, dense, deferred-button" focusTraversable="false">
                        <graphic><FontIcon iconLiteral="mdi2c-compare-horizontal"/></graphic>
                    </Button>

                    <!-- Export Menu Button -->
                    <MenuButton text="Export" styleClass="flat, dense">
                        <graphic><FontIcon iconLiteral="fth-download"/></graphic>
                        <items>
                            <MenuItem text="Export as CSV..." onAction="#handleExportCsv"/>
                            <MenuItem text="Export as JSON..." onAction="#handleExportJson"/>
                            <MenuItem text="Export as Markdown Table..." onAction="#handleExportMarkdown"/>
                            <SeparatorMenuItem/>
                            <MenuItem text="Open in Excel" onAction="#handleOpenInExcel"/>
                            <MenuItem text="Save Results As..." onAction="#handleSaveResultsAs"/>
                        </items>
                    </MenuButton>

                    <Separator orientation="VERTICAL"/>

                    <!-- Maximize / Restore Results -->
                    <Button onAction="#handleToggleMaximize" styleClass="icon-button, mini" focusTraversable="false">
                        <graphic><FontIcon fx:id="maximizeIcon" iconLiteral="fth-maximize-2"/></graphic>
                        <tooltip><Tooltip text="Maximize / Restore Results Panel (Ctrl+Alt+R)"/></tooltip>
                    </Button>

                    <!-- Undock Floating Window PoC -->
                    <Button onAction="#handleUndock" styleClass="icon-button, mini" focusTraversable="false">
                        <graphic><FontIcon iconLiteral="fth-external-link"/></graphic>
                        <tooltip><Tooltip text="Pop out into Floating Window (Multi-Monitor Mode)"/></tooltip>
                    </Button>
                </HBox>

                <!-- Table Content Stack -->
                <StackPane fx:id="resultsStackPane" VBox.vgrow="ALWAYS">
                    <!-- Single TableView (default) -->
                    <TableView fx:id="resultsTable" VBox.vgrow="ALWAYS" styleClass="results-table"/>

                    <!-- Phase 4 (Gate B 2026-11-05): several result sets stacked vertically, each collapsible -->
                    <ScrollPane fx:id="multiGridScroll" fitToWidth="true" hbarPolicy="NEVER" visible="false" managed="false" styleClass="multi-grid-scroll">
                        <VBox fx:id="multiGridBox" styleClass="multi-grid-box"/>
                    </ScrollPane>

                    <!-- Empty State Box -->
                    <VBox fx:id="emptyStateBox" visible="false" managed="false" alignment="CENTER" spacing="8" styleClass="explorer-empty-state">
                        <FontIcon iconLiteral="fth-grid" iconSize="32" styleClass="empty-state-icon"/>
                        <Label text="No query executed yet" styleClass="empty-state-title"/>
                        <Label text="Run a query from the editor to see tabular results here" styleClass="empty-state-subtext"/>
                    </VBox>

                    <!-- Loading Overlay -->
                    <VBox fx:id="loadingOverlay" visible="false" managed="false" alignment="CENTER" spacing="12" styleClass="results-loading-overlay">
                        <ProgressIndicator styleClass="results-spinner"/>
                        <Label text="Executing query and fetching rows..." styleClass="loading-text"/>
                    </VBox>
                </StackPane>

                <!-- Execution Statistics Footer Bar (matching user screenshot) -->
                <HBox fx:id="resultsFooterBar" styleClass="grid-execution-stats-bar" spacing="8" alignment="CENTER_LEFT">
                    <Label fx:id="footerRowsLabel" text="0 dòng" styleClass="grid-stat-item"/>
                    <Separator orientation="VERTICAL"/>
                    <Label fx:id="footerDurationBadge" text="0 ms" styleClass="grid-stat-badge">
                        <graphic><FontIcon iconLiteral="fth-clock"/></graphic>
                    </Label>
                    <Separator orientation="VERTICAL"/>
                    <Label fx:id="footerSizeBadge" text="0 B" styleClass="grid-stat-item">
                        <graphic><FontIcon iconLiteral="fth-database"/></graphic>
                    </Label>
                    <Separator orientation="VERTICAL"/>
                    <Label fx:id="footerConnLabel" text="#conn · default · (dbo)" styleClass="grid-stat-item" HBox.hgrow="ALWAYS"/>
                    <Pane HBox.hgrow="ALWAYS"/>
                    <Label text="Trend:" styleClass="grid-stat-item" textFill="#888888"/>
                    <FontIcon iconLiteral="fth-activity" styleClass="grid-stat-item"/>
                    <Button onAction="#handleCopyExecutionStats" styleClass="icon-button, mini" focusTraversable="false">
                        <graphic><FontIcon iconLiteral="fth-copy"/></graphic>
                        <tooltip><Tooltip text="Sao chép thông số thực thi (JSON metrics)"/></tooltip>
                    </Button>
                </HBox>
            </VBox>
        </Tab>

        <!-- 2. Messages SQL Output Tab (New!) -->
        <Tab fx:id="messagesTab" text="Messages">
            <graphic><FontIcon iconLiteral="fth-message-square"/></graphic>
            <VBox VBox.vgrow="ALWAYS">
                <HBox styleClass="results-mini-toolbar" alignment="CENTER_LEFT" spacing="8">
                    <Button onAction="#handleClearSqlMessages" styleClass="icon-button, mini" focusTraversable="false">
                        <graphic><FontIcon iconLiteral="fth-trash-2"/></graphic>
                        <tooltip><Tooltip text="Clear SQL Messages"/></tooltip>
                    </Button>
                    <Button onAction="#handleCopySqlMessages" styleClass="icon-button, mini" focusTraversable="false">
                        <graphic><FontIcon iconLiteral="fth-copy"/></graphic>
                        <tooltip><Tooltip text="Copy All Messages to Clipboard"/></tooltip>
                    </Button>
                    <ToggleButton fx:id="sqlMessagesWrapToggle" onAction="#handleToggleSqlMessagesWrap" styleClass="icon-button, mini" focusTraversable="false">
                        <graphic><FontIcon iconLiteral="fth-align-left"/></graphic>
                        <tooltip><Tooltip text="Toggle Word Wrap"/></tooltip>
                    </ToggleButton>
                    <Pane HBox.hgrow="ALWAYS"/>
                </HBox>
                <TextArea fx:id="sqlMessagesArea" editable="false" VBox.vgrow="ALWAYS" styleClass="terminal-output-area"/>
            </VBox>
        </Tab>

        <!-- 3. Timeline Log Console Tab (Renamed from old Messages tab) -->
        <Tab fx:id="timelineTab" text="Timeline (4)">
            <graphic><FontIcon iconLiteral="fth-clock"/></graphic>
            <VBox VBox.vgrow="ALWAYS">
                <HBox styleClass="results-mini-toolbar" alignment="CENTER_LEFT" spacing="8">
                    <Button onAction="#handleClearMessages" styleClass="icon-button, mini" focusTraversable="false">
                        <graphic><FontIcon iconLiteral="fth-trash-2"/></graphic>
                        <tooltip><Tooltip text="Clear Timeline"/></tooltip>
                    </Button>
                    <Button onAction="#handleCopyAllMessages" styleClass="icon-button, mini" focusTraversable="false">
                        <graphic><FontIcon iconLiteral="fth-copy"/></graphic>
                        <tooltip><Tooltip text="Copy Timeline to Clipboard"/></tooltip>
                    </Button>
                    <Pane HBox.hgrow="ALWAYS"/>
                </HBox>

                <TableView fx:id="messagesTable" VBox.vgrow="ALWAYS" styleClass="messages-table">
                    <columns>
                        <TableColumn fx:id="msgTimeCol" text="Time" prefWidth="110"/>
                        <TableColumn fx:id="msgLevelCol" text="Level" prefWidth="80"/>
                        <TableColumn fx:id="msgTextCol" text="Message" prefWidth="550"/>
                        <TableColumn fx:id="msgDurationCol" text="Duration" prefWidth="90"/>
                    </columns>
                </TableView>
            </VBox>
        </Tab>

        <!-- 4. Execution Plan Tab -->
        <Tab fx:id="executionPlanTab" text="Execution Plan">
            <graphic><FontIcon iconLiteral="fth-git-commit"/></graphic>
            <VBox fx:id="planContainer" VBox.vgrow="ALWAYS" spacing="0">
                <!-- Plan Action Bar / Summary Bar -->
                <HBox alignment="CENTER_LEFT" spacing="8" styleClass="results-toolbar">
                    <Button fx:id="btnFetchEstimatedPlan" onAction="#handleFetchEstimatedPlan" text="Est Plan" styleClass="small">
                        <graphic><FontIcon iconLiteral="fth-file-text"/></graphic>
                        <tooltip><Tooltip text="Lấy Estimated Execution Plan (Ctrl+L - An toàn, không chạy query)"/></tooltip>
                    </Button>
                    <Button fx:id="btnFetchActualPlan" onAction="#handleFetchActualPlan" text="Act Plan" styleClass="small">
                        <graphic><FontIcon iconLiteral="fth-play"/></graphic>
                        <tooltip><Tooltip text="Lấy Actual Execution Plan (Ctrl+M - Thực thi query đo thời gian thực tế)"/></tooltip>
                    </Button>
                    <Separator orientation="VERTICAL"/>
                    <ToggleButton fx:id="togglePlanViewMode" onAction="#handleTogglePlanViewMode" text="Raw Text" styleClass="small">
                        <graphic><FontIcon iconLiteral="fth-align-left"/></graphic>
                        <tooltip><Tooltip text="Chuyển đổi giữa Cây trực quan (Visual Tree) và Văn bản thô (Raw Text)"/></tooltip>
                    </ToggleButton>
                    <Button fx:id="btnCopyPlan" onAction="#handleCopyExecutionPlan" styleClass="small, icon-button">
                        <graphic><FontIcon iconLiteral="fth-copy"/></graphic>
                        <tooltip><Tooltip text="Sao chép Execution Plan vào Clipboard"/></tooltip>
                    </Button>
                    <Pane HBox.hgrow="ALWAYS"/>
                    <Label fx:id="planDialectBadge" text="SQLSERVER" styleClass="badge-pill, badge-info" visible="false"/>
                    <Label fx:id="planTypeBadge" text="ESTIMATED" styleClass="badge-pill, badge-warning" visible="false"/>
                    <Label fx:id="planTotalCostLabel" text="" styleClass="grid-stat-item"/>
                    <Label fx:id="planOperatorsCountLabel" text="" styleClass="grid-stat-item"/>
                    <Label fx:id="planDurationLabel" text="" styleClass="grid-stat-item"/>
                </HBox>

                <!-- Stack Content Area -->
                <StackPane VBox.vgrow="ALWAYS">
                    <!-- Empty State -->
                    <VBox fx:id="planEmptyStateBox" alignment="CENTER" spacing="12" styleClass="explorer-empty-state">
                        <FontIcon iconLiteral="fth-activity" iconSize="36" styleClass="empty-state-icon"/>
                        <Label text="Chưa có Execution Plan" styleClass="empty-state-title"/>
                        <Label text="Bấm Est Plan (Ctrl+L) hoặc Act Plan (Ctrl+M) để phân tích cây toán tử và chi phí truy vấn." styleClass="empty-state-subtext"/>
                        <HBox alignment="CENTER" spacing="8" styleClass="plan-badge-preview">
                            <Button onAction="#handleFetchEstimatedPlan" text="Lấy Estimated Plan (Ctrl+L)" styleClass="accent, small">
                                <graphic><FontIcon iconLiteral="fth-file-text"/></graphic>
                            </Button>
                            <Button onAction="#handleFetchActualPlan" text="Lấy Actual Plan (Ctrl+M)" styleClass="button-outlined, small">
                                <graphic><FontIcon iconLiteral="fth-play"/></graphic>
                            </Button>
                        </HBox>
                    </VBox>

                    <!-- Loading State -->
                    <VBox fx:id="planLoadingBox" alignment="CENTER" spacing="12" styleClass="results-loading-overlay" visible="false" managed="false">
                        <ProgressIndicator styleClass="results-spinner"/>
                        <Label text="Đang tạo Execution Plan..." styleClass="loading-text"/>
                    </VBox>

                    <!-- Visual View: SplitPane (Tree on Left, Inspector on Right) -->
                    <SplitPane fx:id="planVisualSplitPane" orientation="HORIZONTAL" dividerPositions="0.62" visible="false" managed="false" VBox.vgrow="ALWAYS">
                        <!-- Left: Visual Tree -->
                        <VBox spacing="0">
                            <HBox alignment="CENTER_LEFT" spacing="6" styleClass="table-subpane-header">
                                <Label text="Operator Hierarchy &amp; Cost Breakdown" styleClass="grid-subpane-title"/>
                                <Pane HBox.hgrow="ALWAYS"/>
                                <Label text="Click một toán tử để xem chi tiết" styleClass="text-muted" style="-fx-font-size: 10.5px;"/>
                            </HBox>
                            <TreeView fx:id="planTreeView" VBox.vgrow="ALWAYS" styleClass="plan-tree-view"/>
                        </VBox>

                        <!-- Right: Operator Inspector -->
                        <VBox spacing="0" styleClass="plan-inspector-container">
                            <HBox alignment="CENTER_LEFT" spacing="6" styleClass="table-subpane-header">
                                <FontIcon iconLiteral="fth-info" styleClass="text-muted"/>
                                <Label text="Operator Inspector" styleClass="grid-subpane-title"/>
                                <Pane HBox.hgrow="ALWAYS"/>
                                <Label fx:id="inspectorOpBadge" text="" styleClass="badge-pill, badge-info"/>
                            </HBox>
                            <TableView fx:id="inspectorPropertiesTable" VBox.vgrow="ALWAYS" styleClass="results-table, plan-inspector-table">
                                <columns>
                                    <TableColumn fx:id="propNameCol" text="Thuộc tính" prefWidth="130"/>
                                    <TableColumn fx:id="propValueCol" text="Giá trị" prefWidth="220"/>
                                </columns>
                                <columnResizePolicy>
                                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                                </columnResizePolicy>
                            </TableView>
                        </VBox>
                    </SplitPane>

                    <!-- Raw Text View -->
                    <VBox fx:id="planRawBox" visible="false" managed="false" VBox.vgrow="ALWAYS" styleClass="p-2">
                        <TextArea fx:id="planRawTextArea" VBox.vgrow="ALWAYS" editable="false" wrapText="true" styleClass="plan-raw-textarea"/>
                    </VBox>
                </StackPane>
            </VBox>
        </Tab>

        <!-- 5. Terminal Tab -->
        <Tab fx:id="terminalTab" text="Terminal">
            <graphic><FontIcon iconLiteral="fth-terminal"/></graphic>
            <VBox VBox.vgrow="ALWAYS" styleClass="terminal-container">
                <TextArea fx:id="terminalOutput" VBox.vgrow="ALWAYS" styleClass="terminal-output-area"/>
                <HBox styleClass="terminal-input-bar" alignment="CENTER_LEFT" spacing="6">
                    <Label text="postgres=#" styleClass="terminal-prompt-label"/>
                    <TextField fx:id="terminalInput" promptText="Enter SQL command or \\? for help..." styleClass="terminal-input-field" HBox.hgrow="ALWAYS"/>
                </HBox>
            </VBox>
        </Tab>
    </TabPane>
</VBox>
