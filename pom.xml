<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.sqlide</groupId>
    <artifactId>sql-ide</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>jar</packaging>

    <name>SQL IDE</name>
    <description>Modern SQL IDE Desktop Application built with JavaFX</description>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
        <maven.compiler.release>21</maven.compiler.release>
        <javafx.version>21.0.5</javafx.version>
        <atlantafx.version>2.0.1</atlantafx.version>
        <controlsfx.version>11.2.1</controlsfx.version>
        <ikonli.version>12.3.1</ikonli.version>
        <richtextfx.version>0.11.4</richtextfx.version>
        <junit.version>5.10.2</junit.version>
        <jna.version>5.14.0</jna.version>
    </properties>

    <dependencies>
        <!-- JavaFX Controls, FXML, Graphics -->
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-controls</artifactId>
            <version>${javafx.version}</version>
        </dependency>
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-fxml</artifactId>
            <version>${javafx.version}</version>
        </dependency>
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-graphics</artifactId>
            <version>${javafx.version}</version>
        </dependency>
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-web</artifactId>
            <version>${javafx.version}</version>
        </dependency>

        <!-- AtlantaFX Theme System -->
        <dependency>
            <groupId>io.github.mkpaz</groupId>
            <artifactId>atlantafx-base</artifactId>
            <version>${atlantafx.version}</version>
        </dependency>

        <!-- ControlsFX for advanced UI controls and notifications -->
        <dependency>
            <groupId>org.controlsfx</groupId>
            <artifactId>controlsfx</artifactId>
            <version>${controlsfx.version}</version>
        </dependency>

        <!-- Ikonli Icon System -->
        <dependency>
            <groupId>org.kordamp.ikonli</groupId>
            <artifactId>ikonli-javafx</artifactId>
            <version>${ikonli.version}</version>
        </dependency>
        <dependency>
            <groupId>org.kordamp.ikonli</groupId>
            <artifactId>ikonli-feather-pack</artifactId>
            <version>${ikonli.version}</version>
        </dependency>
        <dependency>
            <groupId>org.kordamp.ikonli</groupId>
            <artifactId>ikonli-materialdesign2-pack</artifactId>
            <version>${ikonli.version}</version>
        </dependency>

        <!-- RichTextFX for SQL Editor Syntax Highlighting PoC -->
        <dependency>
            <groupId>org.fxmisc.richtext</groupId>
            <artifactId>richtextfx</artifactId>
            <version>${richtextfx.version}</version>
        </dependency>

        <!-- JNA: native Win32 integration for the custom title bar
             (Aero Snap, Snap Layouts, Win+Arrow, taskbar-aware maximize) -->
        <dependency>
            <groupId>net.java.dev.jna</groupId>
            <artifactId>jna-platform</artifactId>
            <version>${jna.version}</version>
        </dependency>

        <!-- Core Platform Integration (Phase 2) -->
        <dependency>
            <groupId>com.lltool.core</groupId>
            <artifactId>core-api</artifactId>
            <version>1.0.0-SNAPSHOT</version>
        </dependency>
        <dependency>
            <groupId>com.lltool.core</groupId>
            <artifactId>core-common</artifactId>
            <version>1.0.0-SNAPSHOT</version>
        </dependency>
        <dependency>
            <groupId>com.lltool.core</groupId>
            <artifactId>core-domain</artifactId>
            <version>1.0.0-SNAPSHOT</version>
        </dependency>
        <dependency>
            <groupId>com.lltool.core</groupId>
            <artifactId>core-application</artifactId>
            <version>1.0.0-SNAPSHOT</version>
        </dependency>

        <!-- Infrastructure Integration (Phase 3) -->
        <dependency>
            <groupId>com.lltool.infrastructure</groupId>
            <artifactId>logging</artifactId>
            <version>1.0.0-SNAPSHOT</version>
        </dependency>
        <dependency>
            <groupId>com.lltool.infrastructure</groupId>
            <artifactId>configuration</artifactId>
            <version>1.0.0-SNAPSHOT</version>
        </dependency>
        <dependency>
            <groupId>com.lltool.infrastructure</groupId>
            <artifactId>filesystem</artifactId>
            <version>1.0.0-SNAPSHOT</version>
        </dependency>
        <dependency>
            <groupId>com.lltool.infrastructure</groupId>
            <artifactId>storage-local</artifactId>
            <version>1.0.0-SNAPSHOT</version>
        </dependency>
        <dependency>
            <groupId>com.lltool.infrastructure</groupId>
            <artifactId>security</artifactId>
            <version>1.0.0-SNAPSHOT</version>
        </dependency>
        <dependency>
            <groupId>com.lltool.infrastructure</groupId>
            <artifactId>database-api</artifactId>
            <version>1.0.0-SNAPSHOT</version>
        </dependency>
        <dependency>
            <groupId>com.lltool.infrastructure</groupId>
            <artifactId>database-jdbc</artifactId>
            <version>1.0.0-SNAPSHOT</version>
        </dependency>
        <dependency>
            <groupId>com.lltool.infrastructure</groupId>
            <artifactId>database-postgresql</artifactId>
            <version>1.0.0-SNAPSHOT</version>
        </dependency>
        <dependency>
            <groupId>com.lltool.infrastructure</groupId>
            <artifactId>database-sqlite</artifactId>
            <version>1.0.0-SNAPSHOT</version>
        </dependency>
        <dependency>
            <groupId>com.lltool.infrastructure</groupId>
            <artifactId>database-sqlserver</artifactId>
            <version>1.0.0-SNAPSHOT</version>
        </dependency>

        <!-- JUnit 5 Testing -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-api</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-engine</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
                <configuration>
                    <release>${maven.compiler.release}</release>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>3.4.1</version>
                <configuration>
                    <archive>
                        <manifest>
                            <addClasspath>true</addClasspath>
                            <classpathPrefix>lib/</classpathPrefix>
                            <mainClass>app.Main</mainClass>
                        </manifest>
                    </archive>
                </configuration>
            </plugin>
            <plugin>
                <!-- Windows (integrated) authentication for SQL Server needs the driver's native DLL next to the app.
                     Must match the mssql-jdbc version used by infrastructure (12.6.1). Downloaded once from Maven Central. -->
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <version>3.6.1</version>
                <executions>
                    <execution>
                        <id>copy-mssql-auth-dll</id>
                        <phase>generate-resources</phase>
                        <goals>
                            <goal>copy</goal>
                        </goals>
                        <configuration>
                            <artifactItems>
                                <artifactItem>
                                    <groupId>com.microsoft.sqlserver</groupId>
                                    <artifactId>mssql-jdbc_auth</artifactId>
                                    <version>12.6.1.x64</version>
                                    <type>dll</type>
                                    <outputDirectory>${project.basedir}/native</outputDirectory>
                                </artifactItem>
                            </artifactItems>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.openjfx</groupId>
                <artifactId>javafx-maven-plugin</artifactId>
                <version>0.0.8</version>
                <configuration>
                    <mainClass>app.application.AppLauncher</mainClass>
                    <options>
                        <option>--enable-native-access=ALL-UNNAMED</option>
                        <!-- SQL Server Windows authentication: folder with mssql-jdbc_auth-<version>.x64.dll (copied below) -->
                        <option>-Djava.library.path=${project.basedir}/native</option>
                        <!-- Crisp DirectWrite ClearType font rendering -->
                        <option>-Dprism.lcdtext=true</option>
                    </options>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.2.5</version>
                <configuration>
                    <!-- Phase 8: unit tests never touch real servers (in-memory SQLite sandbox / mock metadata) -->
                    <systemPropertyVariables>
                        <sqlide.backend>mock</sqlide.backend>
                        <!-- Tests must never write to the user's real data (%APPDATA%\LLTool-Desktop): connections, vault, settings, workspaces.
                             Do not override APPDATA instead: QueryDbIT and GridPerfIT read their settings from there. -->
                        <sqlide.dataDir>${project.build.directory}/test-appdata</sqlide.dataDir>
                        <!-- Keeps AppDirectoryManager's first-start migration from copying ~/.lltool (vault included) into the folder above,
                             and keeps the code that still uses ~/.lltool or ~/.sqlide away from the real home folder. -->
                        <user.home>${project.build.directory}/test-home</user.home>
                        <!-- Keeps Java Preferences away from Windows Registry (HKCU\Software\JavaSoft\Prefs) -->
                        <java.util.prefs.PreferencesFactory>app.test.InMemoryPreferencesFactory</java.util.prefs.PreferencesFactory>
                    </systemPropertyVariables>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
