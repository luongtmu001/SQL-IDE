{
  "schemaVersion": "1.0",
  "status": "approved",
  "source_note": "Màu: token AtlantaFX (Primer). Hex là giá trị tham chiếu của GitHub Primer (inferred), runtime luôn dùng biến -color-*. Kích thước: đo trên app JavaFX hiện tại + chuẩn VS Code + nguồn LLTool.",
  "color": {
    "app-bg": {
      "fx": "-color-bg-subtle",
      "light": "#f6f8fa",
      "dark": "#161b22",
      "purpose": "Nền cửa sổ, khe giữa các panel"
    },
    "surface-1": {
      "fx": "-color-bg-default",
      "light": "#ffffff",
      "dark": "#0d1117",
      "purpose": "Editor, cây Explorer, grid"
    },
    "surface-2": {
      "fx": "-color-bg-subtle",
      "light": "#f6f8fa",
      "dark": "#161b22",
      "purpose": "Title bar, header panel, status bar trung tính, pill"
    },
    "surface-elevated": {
      "fx": "-color-bg-overlay",
      "light": "#ffffff",
      "dark": "#161b22",
      "purpose": "Menu, popup, dialog, notification"
    },
    "surface-hover": {
      "fx": "-color-bg-muted (định nghĩa trong base.css)",
      "light": "derive(bg-subtle,-6%)",
      "dark": "derive(bg-subtle,-6%)",
      "purpose": "Hover trên nền subtle"
    },
    "border-subtle": {
      "fx": "-color-border-subtle",
      "light": "#d8dee4",
      "dark": "#21262d",
      "purpose": "Viền chia panel, hairline"
    },
    "border-default": {
      "fx": "-color-border-default",
      "light": "#d0d7de",
      "dark": "#30363d",
      "purpose": "Viền control (combo, input)"
    },
    "text-primary": {
      "fx": "-color-fg-default",
      "light": "#1f2328",
      "dark": "#e6edf3",
      "purpose": "Chữ chính"
    },
    "text-secondary": {
      "fx": "-color-fg-muted",
      "light": "#656d76",
      "dark": "#7d8590",
      "purpose": "Chữ phụ, nhãn"
    },
    "text-muted": {
      "fx": "-color-fg-subtle",
      "light": "#6e7781",
      "dark": "#6e7681",
      "purpose": "Placeholder, disabled, title bar inactive"
    },
    "accent": {
      "fx": "-color-accent-emphasis / -color-accent-fg",
      "light": "#0969da",
      "dark": "#1f6feb / #2f81f7",
      "purpose": "Nút Run, selection, focus, link"
    },
    "on-accent": {
      "fx": "-color-fg-emphasis",
      "light": "#ffffff",
      "dark": "#ffffff",
      "purpose": "Chữ trên nền accent"
    },
    "success": {
      "fx": "-color-success-fg",
      "light": "#1a7f37",
      "dark": "#3fb950",
      "purpose": "Kết nối OK, query thành công, env TEST"
    },
    "warning": {
      "fx": "-color-warning-fg / -subtle",
      "light": "#9a6700 / #fff8c5",
      "dark": "#d29922 / rgba(187,128,9,.15)",
      "purpose": "STAGING/UAT, cảnh báo"
    },
    "danger": {
      "fx": "-color-danger-fg / -emphasis",
      "light": "#d1242f / #cf222e",
      "dark": "#f85149 / #da3633",
      "purpose": "PROD, Stop, lỗi, thao tác xóa"
    },
    "focus": {
      "fx": "-color-accent-emphasis",
      "light": "#0969da",
      "dark": "#1f6feb",
      "purpose": "Viền focus 1px + vòng 2px"
    },
    "window-close-hover": {
      "fx": "literal",
      "light": "#e81123",
      "dark": "#e81123",
      "purpose": "Nút Close (chuẩn Windows)"
    },
    "env": {
      "DEV": "accent-subtle / accent-fg",
      "TEST": "success-subtle / success-fg",
      "STAGING": "warning-subtle / warning-fg",
      "PROD": "danger-emphasis / fg-emphasis"
    }
  },
